opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/skyline"
bug-reports: "https://github.com/janestreet/skyline/issues"
dev-repo: "git+https://github.com/janestreet/skyline.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/skyline/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.2.0"}
  "am_running_how_js"
  "async_js"
  "async_kernel"
  "base"
  "bonsai"
  "bonsai_test"
  "bonsai_web"
  "bonsai_web_components"
  "bonsai_web_test"
  "browser"
  "core"
  "core_kernel"
  "expect_test_helpers_core"
  "expectable"
  "fuzzy_match"
  "incr_map"
  "incremental"
  "patdiff"
  "ppx_bin_and_sexp_digest"
  "ppx_css"
  "ppx_delta_types"
  "ppx_here"
  "ppx_html"
  "ppx_jane"
  "ppx_loc"
  "ppx_pattern_bind"
  "ppx_quick_test"
  "ppx_stable_witness"
  "ppx_with"
  "textutils"
  "toplayer"
  "virtual_dom"
  "dune"                     {>= "3.17.0"}
  "gen_js_api"               {= "1.1.2+ox"}
  "js_of_ocaml"              {= "6.0.1+ox"}
  "js_of_ocaml-ppx"          {= "6.0.1+ox"}
  "omd"                      {= "2.0.0~alpha4+ox"}
]
available: arch != "arm32" & arch != "x86_32"
synopsis: "A Bonsai web component library."
description: "
A Bonsai web component library.
"
